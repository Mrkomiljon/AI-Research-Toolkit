# Copy to .env (never commit .env). All keys are OPTIONAL: Crossref and OpenAlex work without keys.
# Polite-pool contact e-mail for Crossref/OpenAlex (improves rate limits; sent only to those APIs).
RTK_CONTACT_EMAIL=
# Semantic Scholar API key (optional; without it the public rate limit applies).
SEMANTIC_SCHOLAR_API_KEY=
# Set to 0 to forbid every outbound API call (privacy mode). Default 1.
RTK_ALLOW_EXTERNAL_APIS=1
# Default workspace root for `rtk init` (defaults to ./workspace).
RTK_WORKSPACE_ROOT=
